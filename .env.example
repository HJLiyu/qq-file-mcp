# Copy to .env; use an explicit --env-file path when starting the program.
# snowluma: share the desktop QQ session; napcat: standalone Shell login.
QQ_FILE_BACKEND=snowluma
ONEBOT_URL=http://127.0.0.1:3000
ONEBOT_TOKEN=replace-with-your-local-onebot-token
# Existing NAPCAT_URL / NAPCAT_TOKEN configs still work (default backend: napcat).

# Optional: absolute local paths. Leave unset to use home-directory defaults.
# QQ_FILE_STATE_DIR=C:\Users\you\.qq-file-mcp
# Use a separate state directory when switching bridge implementations.
# QQ_FILE_DOWNLOAD_DIR=C:\Users\you\Downloads\QQ-File-MCP
# Windows separates allowed QQ cache roots with ; (Linux/macOS uses :).
# QQ_FILE_ALLOWED_ROOTS=C:\path\to\napcat;C:\Users\you\Documents\Tencent Files

QQ_FILE_REQUEST_TIMEOUT=20
QQ_FILE_SEARCH_TIMEOUT=40
QQ_FILE_DOWNLOAD_TIMEOUT=180
QQ_FILE_DIRECTORY_LIMIT=10000
QQ_FILE_FOLDER_LIMIT=100
QQ_FILE_MAX_DOWNLOAD_MB=512
